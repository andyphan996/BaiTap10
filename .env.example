# Copy file này thành .env (ngang cấp với pom.xml) rồi sửa thông số cho phù hợp với máy mình.
# File .env đã được đưa vào .gitignore nên sẽ không bị đẩy lên GitHub.
# ===============================
# DATABASE
# ===============================
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=webst4;encrypt=false;trustServerCertificate=true;sslProtocol=TLSv1.2;characterEncoding=UTF-8
DB_USERNAME=sa
DB_PASSWORD=your-password
# ===============================
# JPA
# ===============================
DDL_AUTO=update
SHOW_SQL=true
# ===============================
# SERVER
# ===============================
SERVER_PORT=8088
# ===============================
# ADMIN mặc định
# ===============================
ADMIN_EMAIL=trungnh@hcmute.edu.vn
ADMIN_PASSWORD=123456
# ===============================
# SMTP
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
# ===============================
# CLOUDINARY
# ===============================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
